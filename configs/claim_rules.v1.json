{
  "schema_version": "1.0.0",
  "ruleset_id": "fill-claims-v1",
  "ruleset_version": "1.0.0",
  "frozen_before_audit": true,
  "claim_classes": [
    "supported",
    "conditional",
    "unsupported",
    "overstated",
    "prohibited"
  ],
  "prohibited_without_separate_evidence": [
    "achieved_savings",
    "compliance_guarantee",
    "optimal_production_setpoint",
    "safe_production_setpoint",
    "successful_live_deployment",
    "causal_improvement",
    "universal_cross_domain_validity",
    "zero_underfill_risk",
    "replaces_engineers"
  ],
  "mandatory_boundary_concepts": [
    "retrospective_screening_analysis",
    "no_autonomous_control",
    "no_compliance_certification",
    "no_achieved_savings_evidence",
    "no_direct_setpoint_recommendation",
    "controlled_pilot_and_engineering_review_required"
  ],
  "mandatory_phrase": "retrospective screening reference",
  "export_enforcement_rules": [
    {
      "rule_id": "prohibited_material_or_headline_claim",
      "version": "1.0.0",
      "category": "claim_rule",
      "description": "A prohibited material or headline claim blocks export.",
      "blocks_export": true
    },
    {
      "rule_id": "unresolved_unsupported_or_overstated_material_or_headline",
      "version": "1.0.0",
      "category": "claim_rule",
      "description": "An unresolved unsupported or overstated material or headline claim blocks export.",
      "blocks_export": true
    },
    {
      "rule_id": "conditional_claim_missing_required_qualifier",
      "version": "1.0.0",
      "category": "claim_rule",
      "description": "A conditional claim without its required qualifier blocks export.",
      "blocks_export": true
    },
    {
      "rule_id": "deterministic_precheck_failure",
      "version": "1.0.0",
      "category": "claim_rule",
      "description": "A deterministic precheck failure blocks free-form export.",
      "blocks_export": true
    },
    {
      "rule_id": "supporting_removal_hides_material_limitations",
      "version": "1.0.0",
      "category": "claim_rule",
      "description": "Supporting claim removal is forbidden when it would hide a material limitation.",
      "blocks_export": true
    }
  ]
}
