{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://riec-guard.local/schemas/evidence-ledger.schema.json",
  "title": "RIEC Guard Evidence Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "canonicalization",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^RUN-[A-F0-9]{12}$"
    },
    "canonicalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "json_encoding",
        "sort_keys",
        "excluded_fields",
        "hash_algorithm",
        "id_format"
      ],
      "properties": {
        "json_encoding": {
          "const": "utf-8"
        },
        "sort_keys": {
          "const": true
        },
        "excluded_fields": {
          "type": "array",
          "const": [
            "evidence_id",
            "created_at",
            "content_sha256"
          ]
        },
        "hash_algorithm": {
          "const": "sha256"
        },
        "id_format": {
          "const": "EV-<COMPONENT>-<FIRST12_UPPER_HEX>"
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/evidence_item"
      }
    }
  },
  "$defs": {
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_sha256",
        "locator"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "locator": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        }
      }
    },
    "evidence_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "content_sha256",
        "component",
        "kind",
        "status",
        "statement",
        "value",
        "unit",
        "source_refs",
        "parent_evidence_ids",
        "input_sha256",
        "contract_sha256",
        "implementation_version",
        "created_at"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "pattern": "^EV-[A-Z0-9_]{2,16}-[A-F0-9]{12}$"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "component": {
          "enum": [
            "CONTRACT",
            "PROFILE",
            "RIEC",
            "PROTOCOL",
            "BOOTSTRAP",
            "STABILITY",
            "ACTION",
            "BOUNDARY",
            "CLAIM",
            "SYSTEM"
          ]
        },
        "kind": {
          "enum": [
            "statistic",
            "diagnostic",
            "warning",
            "failure",
            "boundary",
            "decision_reason",
            "provenance",
            "claim_rule"
          ]
        },
        "status": {
          "enum": [
            "ok",
            "warning",
            "material",
            "blocking",
            "not_applicable"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "maxLength": 3000
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            },
            {
              "type": "array",
              "maxItems": 1000,
              "items": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string"
                  }
                ]
              }
            },
            {
              "type": "object"
            }
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 32
        },
        "source_refs": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/source_ref"
          }
        },
        "parent_evidence_ids": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^EV-[A-Z0-9_]{2,16}-[A-F0-9]{12}$"
          }
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "contract_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "implementation_version": {
          "type": "string",
          "maxLength": 100
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
