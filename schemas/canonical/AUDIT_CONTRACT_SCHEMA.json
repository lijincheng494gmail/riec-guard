{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://riec-guard.local/schemas/audit-contract.schema.json",
  "title": "RIEC Guard AuditContract",
  "description": "Confirmed, typed contract that defines data semantics, deployment grouping, order, policy, evidence thresholds, RIEC settings, and privacy boundary for one audit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "source",
    "column_mapping",
    "measurement",
    "grouping",
    "ordering",
    "policy",
    "evidence_profile",
    "riec",
    "privacy",
    "unresolved_fields",
    "confirmation"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "contract_id": {
      "type": "string",
      "pattern": "^AC-[A-F0-9]{12}$"
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "model",
        "structured_output_schema_version",
        "fallback_used"
      ],
      "properties": {
        "mode": {
          "enum": [
            "gpt_structured_output",
            "manual_form",
            "versioned_builtin"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "structured_output_schema_version": {
          "type": "string",
          "maxLength": 32
        },
        "fallback_used": {
          "type": "boolean"
        },
        "request_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "dataset_id",
        "dataset_sha256",
        "filename_display",
        "row_count",
        "column_count"
      ],
      "properties": {
        "mode": {
          "enum": [
            "builtin_synthetic",
            "uploaded_public",
            "local_private"
          ]
        },
        "dataset_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
        },
        "dataset_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "filename_display": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 255
        },
        "row_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "column_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "encoding": {
          "enum": [
            "utf-8",
            "utf-8-sig",
            "internal"
          ]
        },
        "synthetic_mechanism": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "stable_symmetric",
            "left_skew_foaming",
            "heavy_tail_particulate",
            "multimodal_streams",
            "batch_drift_change_point",
            "autocorrelated_viscous",
            "density_tare_measurement_uncertainty"
          ]
        }
      }
    },
    "column_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quantity",
        "product",
        "deployment_group",
        "time",
        "stream",
        "shift"
      ],
      "properties": {
        "quantity": {
          "$ref": "#/$defs/column_ref_required"
        },
        "product": {
          "$ref": "#/$defs/column_ref_optional"
        },
        "deployment_group": {
          "$ref": "#/$defs/column_ref_required"
        },
        "time": {
          "$ref": "#/$defs/column_ref_optional"
        },
        "stream": {
          "$ref": "#/$defs/column_ref_optional"
        },
        "shift": {
          "$ref": "#/$defs/column_ref_optional"
        },
        "weight": {
          "$ref": "#/$defs/column_ref_optional"
        },
        "density": {
          "$ref": "#/$defs/column_ref_optional"
        },
        "tare": {
          "$ref": "#/$defs/column_ref_optional"
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quantity_semantics",
        "unit",
        "measurement_resolution",
        "conversion"
      ],
      "properties": {
        "quantity_semantics": {
          "enum": [
            "net_content",
            "gross_weight",
            "net_weight",
            "volume",
            "mass",
            "other"
          ]
        },
        "unit": {
          "type": "string",
          "pattern": "^[A-Za-zµμ%][A-Za-z0-9µμ%./*^ _-]{0,31}$"
        },
        "measurement_resolution": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "conversion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required",
            "method"
          ],
          "properties": {
            "required": {
              "type": "boolean"
            },
            "method": {
              "enum": [
                "none",
                "fixed_density",
                "row_density",
                "gross_minus_tare",
                "custom"
              ]
            },
            "fixed_density": {
              "type": [
                "number",
                "null"
              ],
              "exclusiveMinimum": 0
            },
            "formula_note": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 1000
            }
          }
        }
      }
    },
    "grouping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployment_unit_name",
        "deployment_group_columns",
        "no_random_row_fallback"
      ],
      "properties": {
        "deployment_unit_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "deployment_group_columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "nested_context_columns": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "no_random_row_fallback": {
          "const": true
        }
      }
    },
    "ordering": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "time_column",
        "timezone",
        "within_stream_order_confirmed"
      ],
      "properties": {
        "status": {
          "enum": [
            "confirmed",
            "unavailable",
            "ambiguous"
          ]
        },
        "time_column": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "timezone": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "within_stream_order_confirmed": {
          "type": "boolean"
        },
        "tie_break_columns": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 128
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nominal_quantity",
        "lower_limit",
        "underfill_event",
        "alpha",
        "minimum_actionable_shift",
        "maximum_screening_shift",
        "protocol_spread_tolerance",
        "policy_source"
      ],
      "properties": {
        "nominal_quantity": {
          "type": "number"
        },
        "lower_limit": {
          "type": "number"
        },
        "underfill_event": {
          "const": "adjusted_quantity_strictly_less_than_lower_limit"
        },
        "alpha": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 0.5
        },
        "minimum_actionable_shift": {
          "type": "number",
          "minimum": 0
        },
        "maximum_screening_shift": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "protocol_spread_tolerance": {
          "type": "number",
          "minimum": 0
        },
        "policy_source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "title",
            "text_sha256",
            "user_confirmed"
          ],
          "properties": {
            "kind": {
              "enum": [
                "structured_form",
                "pasted_text",
                "text_file",
                "builtin_profile"
              ]
            },
            "title": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 200
            },
            "text_sha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-f0-9]{64}$"
            },
            "user_confirmed": {
              "type": "boolean"
            }
          }
        },
        "notes": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        }
      }
    },
    "evidence_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_version",
        "min_rows",
        "min_groups_exploratory",
        "min_groups_action",
        "min_expected_tail_count",
        "min_ordered_points_per_stream",
        "min_ordered_coverage",
        "bootstrap_replicates",
        "bootstrap_lower_confidence",
        "bootstrap_max_failure_fraction"
      ],
      "properties": {
        "profile_version": {
          "type": "string",
          "maxLength": 32
        },
        "min_rows": {
          "type": "integer",
          "minimum": 1
        },
        "min_groups_exploratory": {
          "type": "integer",
          "minimum": 2
        },
        "min_groups_action": {
          "type": "integer",
          "minimum": 2
        },
        "min_expected_tail_count": {
          "type": "number",
          "minimum": 1
        },
        "min_ordered_points_per_stream": {
          "type": "integer",
          "minimum": 3
        },
        "min_ordered_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "bootstrap_replicates": {
          "type": "integer",
          "minimum": 100,
          "maximum": 2000
        },
        "bootstrap_lower_confidence": {
          "type": "number",
          "exclusiveMinimum": 0.5,
          "exclusiveMaximum": 1
        },
        "bootstrap_max_failure_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.25
        }
      }
    },
    "riec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_registry_id",
        "baseline_candidate_id",
        "risk_aggregation",
        "c",
        "near_tie_abs_tol",
        "near_tie_rel_tol",
        "splitter",
        "max_exact_logo_groups"
      ],
      "properties": {
        "candidate_registry_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
        },
        "baseline_candidate_id": {
          "const": "M0_intercept"
        },
        "risk_aggregation": {
          "const": "row_weighted_grouped_mse"
        },
        "group_balanced_diagnostic": {
          "type": "boolean"
        },
        "c": {
          "type": "number",
          "minimum": 0
        },
        "near_tie_abs_tol": {
          "type": "number",
          "minimum": 0
        },
        "near_tie_rel_tol": {
          "type": "number",
          "minimum": 0
        },
        "splitter": {
          "const": "leave_one_deployment_group_out"
        },
        "max_exact_logo_groups": {
          "type": "integer",
          "minimum": 2,
          "maximum": 1000
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "raw_rows_to_gpt",
        "direct_identifiers_to_gpt",
        "storage_mode"
      ],
      "properties": {
        "classification": {
          "enum": [
            "public_synthetic",
            "public_user_upload",
            "private_industrial"
          ]
        },
        "raw_rows_to_gpt": {
          "const": false
        },
        "direct_identifiers_to_gpt": {
          "const": false
        },
        "storage_mode": {
          "enum": [
            "ephemeral_public_session",
            "local_private_workspace"
          ]
        },
        "redacted_summary_allowed": {
          "type": "boolean"
        }
      }
    },
    "unresolved_fields": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field_path",
          "severity",
          "question"
        ],
        "properties": {
          "field_path": {
            "type": "string",
            "maxLength": 200
          },
          "severity": {
            "enum": [
              "blocking",
              "warning"
            ]
          },
          "question": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assumption_id",
          "text",
          "source",
          "user_confirmed"
        ],
        "properties": {
          "assumption_id": {
            "type": "string",
            "pattern": "^ASM-[0-9]{3}$"
          },
          "text": {
            "type": "string",
            "maxLength": 1000
          },
          "source": {
            "enum": [
              "user",
              "builtin_profile",
              "gpt_inference",
              "deterministic_inference"
            ]
          },
          "user_confirmed": {
            "type": "boolean"
          }
        }
      }
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "confirmed_fields",
        "confirmed_at"
      ],
      "properties": {
        "status": {
          "enum": [
            "draft",
            "confirmed",
            "rejected"
          ]
        },
        "confirmed_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 200
          }
        },
        "confirmed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "confirmed_by": {
          "enum": [
            "user",
            "versioned_builtin",
            "none"
          ]
        }
      }
    }
  },
  "$defs": {
    "column_ref_required": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "column",
        "confidence",
        "confirmed"
      ],
      "properties": {
        "column": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "confirmed": {
          "type": "boolean"
        }
      }
    },
    "column_ref_optional": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "column",
        "confidence",
        "confirmed"
      ],
      "properties": {
        "column": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "confirmed": {
          "type": "boolean"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "confirmation": {
            "properties": {
              "status": {
                "const": "confirmed"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "unresolved_fields": {
            "not": {
              "contains": {
                "type": "object",
                "properties": {
                  "severity": {
                    "const": "blocking"
                  }
                },
                "required": [
                  "severity"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ordering": {
            "properties": {
              "status": {
                "const": "confirmed"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "ordering": {
            "properties": {
              "time_column": {
                "type": "string",
                "minLength": 1
              },
              "within_stream_order_confirmed": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "measurement": {
            "properties": {
              "conversion": {
                "properties": {
                  "required": {
                    "const": false
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "measurement": {
            "properties": {
              "conversion": {
                "properties": {
                  "method": {
                    "const": "none"
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
