{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://riec-guard.local/schemas/run-manifest.schema.json",
  "title": "RIEC Guard Run Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "mode",
    "started_at",
    "finished_at",
    "status",
    "code",
    "environment",
    "inputs",
    "contract",
    "registries",
    "randomness",
    "gpt",
    "artifacts",
    "privacy",
    "fallbacks"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^RUN-[A-F0-9]{12}$"
    },
    "mode": {
      "enum": [
        "public_builtin",
        "public_upload",
        "local_private"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "status": {
      "enum": [
        "created",
        "running",
        "completed",
        "completed_with_warnings",
        "failed"
      ]
    },
    "code": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit_sha",
        "dirty",
        "build_week_delta_version"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "maxLength": 300
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{7,40}$"
        },
        "dirty": {
          "type": "boolean"
        },
        "build_week_delta_version": {
          "type": "string",
          "maxLength": 50
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python",
        "platform",
        "dependency_lock_sha256"
      ],
      "properties": {
        "python": {
          "type": "string",
          "maxLength": 50
        },
        "platform": {
          "type": "string",
          "maxLength": 300
        },
        "dependency_lock_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "sha256",
          "classification",
          "row_count"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "classification": {
            "enum": [
              "public_synthetic",
              "public_upload",
              "private_industrial",
              "policy_text"
            ]
          },
          "row_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "sha256",
        "schema_version",
        "confirmation_status"
      ],
      "properties": {
        "contract_id": {
          "type": "string",
          "pattern": "^AC-[A-F0-9]{12}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "schema_version": {
          "type": "string"
        },
        "confirmation_status": {
          "enum": [
            "draft",
            "confirmed",
            "rejected"
          ]
        }
      }
    },
    "registries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_registry",
        "protocol_versions",
        "action_engine_version"
      ],
      "properties": {
        "candidate_registry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "sha256"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
            },
            "version": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "protocol_versions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          }
        },
        "action_engine_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "randomness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "global_seed",
        "bootstrap_seed",
        "bootstrap_replicates"
      ],
      "properties": {
        "global_seed": {
          "type": "integer"
        },
        "bootstrap_seed": {
          "type": "integer"
        },
        "bootstrap_replicates": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "gpt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configured_model",
        "api",
        "store",
        "calls"
      ],
      "properties": {
        "configured_model": {
          "type": "string",
          "maxLength": 100
        },
        "api": {
          "const": "responses"
        },
        "store": {
          "const": false
        },
        "calls": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "purpose",
              "status",
              "request_id",
              "model",
              "latency_ms",
              "input_tokens",
              "output_tokens",
              "fallback_used",
              "error_class"
            ],
            "properties": {
              "purpose": {
                "enum": [
                  "contract_compile",
                  "memo_draft",
                  "claim_audit"
                ]
              },
              "status": {
                "enum": [
                  "not_called",
                  "success",
                  "failed",
                  "fallback"
                ]
              },
              "request_id": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 200
              },
              "model": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 100
              },
              "latency_ms": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "input_tokens": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "output_tokens": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "fallback_used": {
                "type": "boolean"
              },
              "error_class": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 200
              }
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "path",
          "sha256",
          "media_type",
          "public_safe"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
          },
          "path": {
            "type": "string",
            "maxLength": 500
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "media_type": {
            "type": "string",
            "maxLength": 100
          },
          "public_safe": {
            "type": "boolean"
          }
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_rows_sent_to_gpt",
        "direct_identifiers_sent_to_gpt",
        "storage_root_class",
        "release_scan_passed"
      ],
      "properties": {
        "raw_rows_sent_to_gpt": {
          "const": false
        },
        "direct_identifiers_sent_to_gpt": {
          "const": false
        },
        "storage_root_class": {
          "enum": [
            "public_ephemeral",
            "private_local"
          ]
        },
        "release_scan_passed": {
          "type": "boolean"
        }
      }
    },
    "fallbacks": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component",
          "trigger",
          "fallback",
          "honesty_label"
        ],
        "properties": {
          "component": {
            "type": "string",
            "maxLength": 100
          },
          "trigger": {
            "type": "string",
            "maxLength": 500
          },
          "fallback": {
            "type": "string",
            "maxLength": 500
          },
          "honesty_label": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    }
  }
}
