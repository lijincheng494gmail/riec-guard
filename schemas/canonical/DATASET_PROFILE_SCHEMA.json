{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://riec-guard.local/schemas/dataset-profile.schema.json",
  "title": "RIEC Guard Redacted Dataset Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "dataset_sha256",
    "row_count",
    "column_profiles",
    "candidate_semantic_mappings",
    "privacy_redaction"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "dataset_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "row_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "column_profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "dtype",
          "missing_fraction",
          "unique_count",
          "safe_examples"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 128
          },
          "dtype": {
            "enum": [
              "integer",
              "number",
              "string",
              "boolean",
              "datetime",
              "unknown"
            ]
          },
          "missing_fraction": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "unique_count": {
            "type": "integer",
            "minimum": 0
          },
          "safe_examples": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "maxLength": 80
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "numeric_summary": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "min",
              "median",
              "max"
            ],
            "properties": {
              "min": {
                "type": "number"
              },
              "median": {
                "type": "number"
              },
              "max": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "candidate_semantic_mappings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "semantic_role",
          "column",
          "confidence",
          "reasons"
        ],
        "properties": {
          "semantic_role": {
            "enum": [
              "quantity",
              "product",
              "deployment_group",
              "time",
              "stream",
              "shift",
              "weight",
              "density",
              "tare"
            ]
          },
          "column": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 128
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "reasons": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "maxLength": 300
            }
          }
        }
      }
    },
    "privacy_redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_rows_included",
        "direct_identifiers_included",
        "high_cardinality_values_included"
      ],
      "properties": {
        "raw_rows_included": {
          "const": false
        },
        "direct_identifiers_included": {
          "const": false
        },
        "high_cardinality_values_included": {
          "const": false
        }
      }
    }
  }
}
